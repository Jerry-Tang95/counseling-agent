# ===== 应用 =====
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===== 数据库 =====
DATABASE_URL="file:./dev.db"

# ===== 加密 / 会话 =====
# 32-byte base64；生产环境必须使用 KMS 或密钥管理服务
ENCRYPTION_KEY=
# 用于匿名 Cookie 签名；生产环境必须替换
AUTH_SECRET=

# ===== LLM =====
# 没有 Key 时保持 LLM_MOCK=true，项目可以直接跑完整演示流程
LLM_MOCK=true
# zhipu | deepseek | 其他 OpenAI-compatible 服务
LLM_PROVIDER=zhipu
LLM_API_KEY=
LLM_MODEL=glm-4.5-flash
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 智谱 GLM 可选：disabled / enabled；其他供应商留空
LLM_THINKING=disabled
